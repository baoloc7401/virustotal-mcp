{
  "version": "0.2.0",
  "configurations": [
    {
      // Run the server from source with tsx. Needs VT_API_KEY in the env
      // (or set it under "env" below). stdout is the JSON-RPC channel.
      "name": "Run MCP server (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      // Debug the current Vitest test file.
      "name": "Debug Vitest (current file)",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
